# ============================================================
#  Currency Converter — .gitignore
#  Keeps source code; ignores everything that is regenerated
#  by a build (npm install / ng build / cap sync / gradle).
# ============================================================

# --- Node / Angular ---
/node_modules
node_modules/
npm-debug.log*
yarn-error.log*
/dist
/tmp
/out-tsc
/bazel-out
.angular/
/.angular/cache
/coverage
*.log

# --- IDEs & editors ---
.idea/
.project
.classpath
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Android / Gradle build outputs (regenerated by gradle) ---
.gradle/
**/build/
*.iml
.cxx/
captures/
android/local.properties
android/.idea/

# --- Generated Capacitor files (regenerated by `npx cap sync android`) ---
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

# --- Packaged app binaries ---
*.apk
*.aab
*.idsig

# NOTE: android.keystore is intentionally NOT ignored so you keep your
# signing key. If this repo is public, consider removing it instead.
